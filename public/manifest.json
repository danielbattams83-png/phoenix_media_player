{
  "name": "Windows Media Player Pro",
  "short_name": "Media Player",
  "description": "High-fidelity Windows Media Player with Web Audio DSP, lossless audio explorer, 5-band equalizer, and real-time spectrum visualizer.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "categories": [
    "music",
    "entertainment",
    "utilities",
    "audio",
    "video"
  ],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Now Playing",
      "short_name": "Playing",
      "description": "Open Now Playing view",
      "url": "/?view=now-playing",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Audio Visualizer",
      "short_name": "Visualizer",
      "description": "Open Spectrum Visualizer",
      "url": "/?view=visualizer",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Media Library",
      "short_name": "Library",
      "description": "Open Lossless Audio Library",
      "url": "/?view=library",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "Audio and Video Tracks",
      "accept": {
        "audio/*": [".mp3", ".wav", ".flac", ".ogg", ".m4a", ".aac"],
        "video/*": [".mp4", ".webm", ".mkv"]
      }
    }
  ]
}

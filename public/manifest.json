{
  "name": "Phoenix Media Player",
  "short_name": "Phoenix Media Player",
  "description": "Phoenix Media Player brings high-fidelity local audio and video playback, Web Audio DSP, a 5-band equalizer, and real-time visualization.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#090b10",
  "theme_color": "#090b10",
  "categories": [
    "music",
    "entertainment",
    "utilities",
    "audio",
    "video"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Now Playing",
      "short_name": "Playing",
      "description": "Open Now Playing view",
      "url": "/?view=now-playing",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Audio Visualizer",
      "short_name": "Visualizer",
      "description": "Open Spectrum Visualizer",
      "url": "/?view=visualizer",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Media Library",
      "short_name": "Library",
      "description": "Open Lossless Audio Library",
      "url": "/?view=library",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "Audio and Video Tracks",
      "accept": {
        "audio/*": [".mp3", ".wav", ".flac", ".ogg", ".m4a", ".aac"],
        "video/*": [".mp4", ".webm", ".mkv"]
      }
    }
  ]
}
